#!/usr/bin/env bash
# Контракт agent-dev-kit, монорепа: автоформат через диспетчеризацию по пакетам.
set -eo pipefail
cd "$(dirname "$0")/.."
root="$PWD"

packages=$(find . -mindepth 3 -maxdepth 5 \( -name node_modules -o -name .git -o -name .venv \) -prune -o -type f -path '*/scripts/fix' -print | sed 's|/scripts/fix$||; s|^\./||' | sort)

if [ $# -eq 0 ]; then
  for p in $packages; do (cd "$root/$p" && ./scripts/fix); done
  exit 0
fi

for p in $packages; do
  pkg_files=()
  for f in "$@"; do
    abs="$f"
    case "$abs" in /*) ;; *) abs="$root/$f" ;; esac
    case "$abs" in "$root/$p"/*) pkg_files+=("$abs") ;; esac
  done
  if [ ${#pkg_files[@]} -gt 0 ]; then
    (cd "$root/$p" && ./scripts/fix "${pkg_files[@]}")
  fi
done
