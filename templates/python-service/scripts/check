#!/usr/bin/env bash
# Контракт agent-dev-kit: статические проверки (линт + типы). Окружение — uv.
set -eo pipefail
cd "$(dirname "$0")/.."

py_targets=()
if [ $# -gt 0 ]; then
  for f in "$@"; do
    case "$f" in
      *.py) py_targets+=("$f") ;;
    esac
  done
  [ ${#py_targets[@]} -gt 0 ] || exit 0
  uv run ruff check "${py_targets[@]}"
  uv run mypy "${py_targets[@]}"
else
  uv run ruff check .
  uv run mypy .
  # scripts/ac-check копируется project-init'ом из agent-dev-kit
  # (hooks/scripts/ac-check.sh); контракт — в документации кита agent-dev-kit,
  # не в этом репозитории.
  if [ -x scripts/ac-check ]; then
    scripts/ac-check .
  fi
fi
