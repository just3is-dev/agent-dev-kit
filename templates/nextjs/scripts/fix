#!/usr/bin/env bash
# Контракт agent-dev-kit: автоформат + авто-исправимый линт.
# Молча правит что может; оставшиеся проблемы — забота scripts/check.
set -eo pipefail
cd "$(dirname "$0")/.."

if [ $# -gt 0 ]; then
  npx prettier --write --ignore-unknown "$@"
  npx eslint --fix --no-error-on-unmatched-pattern "$@" >/dev/null 2>&1 || true
else
  npx prettier --write --ignore-unknown .
  npx eslint --fix . >/dev/null 2>&1 || true
fi
