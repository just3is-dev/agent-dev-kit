#!/usr/bin/env bash
# Контракт agent-dev-kit: статические проверки (типы + линт).
# С аргументами линтит только переданные файлы; типы всегда по всему проекту —
# tsc не умеет проверять один файл в контексте проекта.
# Линтер детектится по package.json (issue #170): генераторы стека меняют
# дефолтный тулинг быстрее, чем шаблон, — хардкод одного инструмента
# регулярно расходится с тем, что реально стоит в проекте.
set -eo pipefail
cd "$(dirname "$0")/.."

npx tsc --noEmit --pretty false

LINT_TOOL=$(node -e '
const pkg = require("./package.json");
const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
if (deps.oxlint) process.stdout.write("oxlint");
else if (deps.eslint) process.stdout.write("eslint");
')
if [ -z "$LINT_TOOL" ]; then
  echo "scripts/check: в package.json нет ни oxlint, ни eslint — контракт agent-dev-kit ожидает один из них в dependencies/devDependencies" >&2
  exit 1
fi

lint_targets=()
if [ $# -gt 0 ]; then
  for f in "$@"; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) lint_targets+=("$f") ;;
    esac
  done
  [ ${#lint_targets[@]} -gt 0 ] || exit 0
  npx "$LINT_TOOL" --max-warnings 0 --no-error-on-unmatched-pattern "${lint_targets[@]}"
else
  if [ "$LINT_TOOL" = "oxlint" ]; then
    npx oxlint --max-warnings 0 --ignore-pattern node_modules .
  else
    npx eslint --max-warnings 0 .
  fi
  # scripts/ac-check копируется project-init'ом из agent-dev-kit
  # (hooks/scripts/ac-check.sh); контракт — в документации кита agent-dev-kit,
  # не в этом репозитории.
  if [ -x scripts/ac-check ]; then
    scripts/ac-check .
  fi
fi
