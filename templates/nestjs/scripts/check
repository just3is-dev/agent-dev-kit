#!/usr/bin/env bash
# Контракт agent-dev-kit: статические проверки (типы + линт).
# С аргументами линтит только переданные файлы; типы всегда по всему проекту —
# tsc не умеет проверять один файл в контексте проекта.
set -eo pipefail
cd "$(dirname "$0")/.."

npx tsc --noEmit --pretty false

lint_targets=()
if [ $# -gt 0 ]; then
  for f in "$@"; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) lint_targets+=("$f") ;;
    esac
  done
  [ ${#lint_targets[@]} -gt 0 ] || exit 0
  npx eslint --max-warnings 0 --no-error-on-unmatched-pattern "${lint_targets[@]}"
else
  npx eslint --max-warnings 0 .
  # AC-трассируемость: только в полном прогоне, только если хелпер скопирован
  # project-init'ом (см. scripts/ac-check); отсутствие ничего не ломает.
  if [ -x scripts/ac-check ]; then
    scripts/ac-check .
  fi
fi
