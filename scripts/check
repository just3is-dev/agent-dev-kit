#!/usr/bin/env bash
# Контракт agent-dev-kit для самого кита: синтаксис bash, валидность JSON,
# валидация плагина. Полный прогон занимает секунды, поэтому аргументы
# (изменённые файлы) не сужают область — проверяем всё всегда.
# С аргументами — без AC-трассируемости (см. docs/contract.md, issue #24):
# частичный прогон зовёт post-edit-check после каждого Edit, а AC-check —
# только хвост полного прогона, как и в templates/*/scripts/check.
set -eo pipefail
cd "$(dirname "$0")/.."

for f in hooks/scripts/* hooks/scripts/lib/* templates/*/scripts/* scripts/* tests/*.sh .github/scripts/*; do
  [ -f "$f" ] || continue
  bash -n "$f"
done

for j in .claude-plugin/plugin.json .claude-plugin/marketplace.json hooks/hooks.json; do
  python3 -m json.tool "$j" >/dev/null
done

# фронтматтер commands/*.md, agents/*.md, skills/*/SKILL.md парсится и несёт
# обязательные ключи (issue #201) — не зависит от аргументов: файлов немного,
# проверка дешёвая, и класс бага (PR #199) не привязан к конкретному
# редактируемому файлу.
hooks/scripts/frontmatter-check.sh .

# номера docs/adr/NNN-*.md уникальны (issue #251): два параллельных PR берут
# один «следующий свободный» номер, и ссылка «ADR-NNN» становится
# неоднозначной. Пропуски в нумерации допустимы — проверяются только дубли.
dup_adr=$(ls docs/adr 2>/dev/null | grep -E '^[0-9]+-.*\.md$' | sed -E 's/^([0-9]+)-.*/\1/' | sort | uniq -d || true)
if [ -n "$dup_adr" ]; then
  echo "check: дубль номера ADR в docs/adr: $(echo $dup_adr | tr '\n' ' ')" >&2
  exit 1
fi

if command -v claude >/dev/null 2>&1; then
  claude plugin validate . >/dev/null 2>&1
fi

if [ $# -eq 0 ]; then
  # трассируемость AC → тест: кит применяет свою же конвенцию к себе
  # (dogfood, issue #9); тестовая область — tests/run.sh.
  hooks/scripts/ac-check.sh . tests/run.sh
fi

echo "check: OK"
